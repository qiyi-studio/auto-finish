{
  "manifest_version": 3,
  "name": "会员离开自动完成",
  "version": "1.1.0",
  "description": "侦测到会员跳出/离开对话时，自动点击「完成」按钮",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "会员离开自动完成"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
